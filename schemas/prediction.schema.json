{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://golo.internal/schemas/prediction.schema.json",
  "title": "Prediction",
  "description": "Mirrors internal/domain/types.go Prediction + Probabilities. See context/Golo_Blueprint_MVP.md §10.2.",
  "type": "object",
  "required": [
    "matchId", "asOfMatchSecond", "calculatedAt", "probabilities", "dataQuality",
    "confidenceBand", "status", "modelVersion", "calibratorVersion", "featureVersion", "predictionSequence"
  ],
  "properties": {
    "matchId": { "type": "string" },
    "asOfMatchSecond": { "type": "integer", "minimum": 0 },
    "calculatedAt": { "type": "string", "format": "date-time" },
    "probabilities": {
      "type": "object",
      "required": ["goalNext5m", "goalNext10m", "goalBeforeFullTime"],
      "properties": {
        "goalNext5m": { "type": "number", "minimum": 0, "maximum": 1 },
        "goalNext10m": { "type": "number", "minimum": 0, "maximum": 1 },
        "goalBeforeFullTime": { "type": "number", "minimum": 0, "maximum": 1 },
        "homeGoalBeforeFullTime": { "type": "number", "minimum": 0, "maximum": 1 },
        "awayGoalBeforeFullTime": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "dataQuality": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidenceBand": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "status": { "type": "string", "enum": ["OK", "STALE", "DEGRADED", "UNAVAILABLE"] },
    "modelVersion": { "type": "string" },
    "calibratorVersion": { "type": "string" },
    "featureVersion": { "type": "string" },
    "predictionSequence": { "type": "integer", "minimum": 0 }
  }
}
