# Copy this file to .env and fill in real values. Never commit .env.

# Data provider: "mock" (synthetic live matches, default) or "sportmonks" (real live feed).
PROVIDER=mock

# Required only when PROVIDER=sportmonks. Get a key via the SportMonks trial:
# https://www.sportmonks.com/football-api/plans-pricing/
SPORTMONKS_API_KEY=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football

# How often the ingestion loop polls the provider for live matches/events.
# One poll = one API request regardless of how many matches are live, since
# /livescores/inplay carries clock, score, statistics and events for all of
# them at once. At 10s that's ~360 requests/hour against a budget of ~3000.
PROVIDER_POLL_INTERVAL_SECONDS=10

# Optional, comma-separated provider competition IDs (SportMonks league_id) in
# priority order — matches from these leagues are surfaced first when
# multiple are live at once. This does NOT restrict which leagues the
# provider fetches: SportMonks scopes that at the account/plan level (you
# pick your leagues in their dashboard), not via this list.
# IDs below verified against /leagues on the current plan (2026-07-25):
# 648=Brasileirão Série A, 1122=Copa Libertadores, 779=MLS, 743=Liga MX.
PRIORITY_COMPETITION_IDS=648,1122,779,743

# HTTP API server port.
PORT=8080

# SQLite eventstore path (WAL mode).
DB_PATH=./golo.db

# Model artifact loaded by internal/predictor.
MODEL_PATH=./models/hazard_v1.json

# Optional: Firebase Realtime Database sync (internal/publisher). Leave blank
# to skip Firebase entirely — the in-process SSE stream to apps/web still works.
FIREBASE_DATABASE_URL=
FIREBASE_AUTH=

# Historical fixtures used by the admin-only chronological strategy backtest.
HISTORICAL_DATASET_PATH=./ml/data/fixtures.jsonl

# Live totals prices. The free Odds-API.io tier is suitable for development
# and dashboard-only shadow evaluation, not a dependable paid service.
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.odds-api.io/v3
ODDS_BOOKMAKER=Bet365
ODDS_POLL_INTERVAL_SECONDS=45

# Both switches default off and are deployment-level ceilings: the dashboard
# cannot bypass either one. Keep false during shadow mode.
ALERT_ENGINE_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Generate the password hash with:
#   htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
# Use a random secret of at least 32 characters.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Production frontend origin, e.g. https://golo.example.com. Leaving it empty
# permits all origins for local development only.
ALLOWED_WEB_ORIGIN=
